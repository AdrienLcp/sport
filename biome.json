{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["@adrienlcp/biome-config", "@adrienlcp/biome-config/react"],
  "files": {
    "includes": ["!**/dev-dist"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Date": "Read the time through infrastructure/clock.ts."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/infrastructure/clock.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
