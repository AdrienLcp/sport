{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "node_modules",
    "pnpm-lock.yaml",
    "dist",
    "dev-dist",
    "patches",
    "coverage",
    "public"
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": [
        "cspell.json",
        "src/features/figures/figure-labels.ts",
        "src/features/figures/figure-names.ts",
        "src/features/program/content/*.ts",
        "src/features/table/table-catalogue.ts",
        "src/presentation/i18n/dictionary-fr.ts"
      ],
      "language": "en,en-GB,fr",
      "words": ["Ischio", "marchées", "Répét"]
    }
  ],
  "version": "0.2",
  "words": [
    "adrien",
    "adrienlcp",
    "Arimo",
    "appinstalled",
    "beforeinstallprompt",
    "bezier",
    "biomejs",
    "chrono",
    "chronophotography",
    "counterpose",
    "counterposes",
    "dasharray",
    "deadlift",
    "emom",
    "esbuild",
    "esnext",
    "figcaption",
    "focusables",
    "fonttools",
    "Français",
    "friday",
    "GDEF",
    "glute",
    "glutes",
    "glyf",
    "gridline",
    "GSUB",
    "gvar",
    "hmtx",
    "HVAR",
    "IHDR",
    "indexeddb",
    "keyval",
    "Lacourpaille",
    "linecap",
    "linejoin",
    "Midstance",
    "minmax",
    "monday",
    "nowrap",
    "nums",
    "oklch",
    "overscroll",
    "periodicsync",
    "precache",
