#!/usr/bin/env sh
# The same checks as CI, so a red run on main is caught before it is pushed:
# actionlint reads the workflows GitHub would refuse to parse. A push of main
# then deploys the owner's personal site; a failed deploy aborts the push.
# Git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin, read before any check can swallow it.

set -e

pushes_main=false
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    pushes_main=true
  fi
done

if ! command -v actionlint >/dev/null 2>&1; then
  echo "actionlint is missing: winget install rhysd.actionlint" >&2
  exit 1
fi
actionlint

pnpm lint:ci
pnpm build
pnpm test:coverage

if [ "$pushes_main" = true ]; then
  sh "$(git rev-parse --show-toplevel)/scripts/deploy-personal-site.sh"
fi
